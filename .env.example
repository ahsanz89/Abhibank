# Public base URL of the site (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://abhibank.vercel.app

# Origin that still hosts the original PDFs and tutorial videos.
# Change this once those files are moved to the new host.
NEXT_PUBLIC_LEGACY_ASSET_ORIGIN=https://abhibank.com

# PostgreSQL connection string for form submissions (Neon, Vercel Postgres, Supabase, RDS…).
# When unset, submissions are written to ./.data/submissions.jsonl (local development only).
DATABASE_URL=

# Optional: e-mail a copy of every submission through Resend (https://resend.com).
RESEND_API_KEY=
NOTIFY_EMAIL_TO=info@abhibank.com
NOTIFY_EMAIL_FROM=ABHI Website <website@abhibank.com>

# Salt used to hash submitter IP addresses before storage (any long random string).
IP_HASH_SALT=change-me
